{
  "name": "bubble-cutter-electron",
  "version": "1.0.4",
  "description": "Bubble Cutter Pro",
  "author": "BubbleCutter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bubble.cutter",
    "productName": "BubbleCutter",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "locales/**/*",
      "icon/bubble.ico"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "icon/bubble.ico"
    }
  }
}
